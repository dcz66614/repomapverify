# T001: persistent scratch (VM /tmp is a 512 MB tmpfs, cleared on restart)
.tmp/
# Node build outputs / deps (regenerable from lockfile)
02_source/node_modules/
02_source/dist/

# T010: demo reports (regenerated by `npm run demo`)
02_source/demo/out/

# Python bytecode (Oracle runs generate these; never commit)
__pycache__/
*.pyc

# T014: release artifacts (source.zip, dist.zip, SHA256SUMS.txt,
# RELEASE_MANIFEST.json) live in 02_source/release/ but are build
# outputs, not source — keep the frozen tree clean.
02_source/release/
